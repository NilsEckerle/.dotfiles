{ // -*- mode: jsonc -*-
  "position": "bottom", // Waybar position (top|bottom|left|right)
  "height": 16,
  "spacing": 0,

  "modules-left": [ "hyprland/workspaces" ],
  "modules-center": [],
  "modules-right": [ "cpu", "memory", "custom/gpu", "pulseaudio", "clock", "custom/mail", "custom/uxplay", "tray" ],

  // Modules configuration
  "clock": {
    // "timezone": "America/New_York",
    "format": "{:%Y-%m-%d - %H:%M}",
    "on-click": "firefox --new-window \"https://calendar.proton.me/\""
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "]
    },
    "on-click": "kitty pulsemixer",
    "on-click-right": "kitty sh -c 'tmux new-session rmpc'"

  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "warp-on-scroll": false,
    "format": "{name}",
    "format-icons": {}
  },
  "tray": {
    "icon-size": 21,
    "spacing": 1
    // "icons": {
    //   "blueman": "bluetooth",
    //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
    // }
  },
  "cpu": {
    "format": "\uf2db  {usage}%",
    "tooltip": false,
    "on-click": "kitty htop -s PERCENT_CPU"
  },
  "memory": {
    "format": "\uf538  {}%",
    "tooltip": false,
    "on-click": "kitty htop -s PERCENT_MEM"
  },
  "keyboard-status": {
    "format": " {name}",
    "format-alt": " {variant}",
    "tooltip": true,
    "tooltip-format": "Layout: {name}\nVariant: {variant}",
    "on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next",
    "on-click-right": "your-keyboard-settings-app"
  },
  "custom/mail": {
    "format": "✉",
    "tooltip": false,
    "on-click": "kitty neomutt"
  },
  "custom/uxplay": {
    "exec": "pgrep -x uxplay > /dev/null && echo '<span color=\"#8ec07c\">󰡁</span>' || echo '<span color=\"#928374\">\uf8e8</span>'",
    "interval": 2,
    "format": "{}",
    "class": "custom_uxplay",
    "tooltip": true,
    "tooltip-format": "UxPlay: Left click to start, right click to stop",
    "on-click": "uxplay > /dev/null 2>&1 &",
    "on-click-right": "killall uxplay && pkill -RTMIN+8 waybar",
    "signal": 8
  },
  "custom/gpu": {
    "format": "󰭰   {}%",
    "tooltip": false,
    "exec": "~/scripts/gpu_ussage.sh",
    "interval": 2,
    "on-click": "kitty radeontop -b 3"
  }
}
