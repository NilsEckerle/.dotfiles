# ProtonMail IMAP settings
set imap_user = "nilseckerle2001@protonmail.com"
set folder = "imap://127.0.0.1:1143"
set spoolfile = "+INBOX"

# ProtonMail SMTP settings
set smtp_url = "smtp://nilseckerle2001@protonmail.com@127.0.0.1:1025"

set from = "nilseckerle2001@protonmail.com"
set realname = "Nils Eckerle"

source ~/.config/mutt/gruvbox/colors-gruvbox.muttrc

set delete = no
set confirmappend = no
set move = no

set sort = "reverse-date"
set editor = "nvim"
set timeout = "5"
set date_format = "%Y-%m-%d %H:%M"
#set index_format = "%4C %Z %{%Y-%m-%d %H:%M} %-15.15L (%?l?%4l&%4c?) %s"
set index_format = "%4C %Z %{%Y-%m-%d %H:%M} %-20.20L (%?l?%4l&%4c?) %s"
set help = no
set status_format = "?:Help q:Quit m:Mail - A:Archive d:Del u:Undel s:Save - r:Reply g:Group-reply t:Tag T:Tag-pattern f:Forward - a:Aliases Ctrl+G:Abort"
set compose_format = "-- [msg size: %l]   [Atts: %a] -- (y:Send  q:Quit  s:Subject  a:Attach  e:Edit  f:From  t:To  c:Cc b:Bcc)"
set markers = no              # Remove the + for wrapped lines
set narrow_tree = yes         # Narrower thread tree
set flag_chars = "*🔴🗑️  N    "
set mailcap_path = "~/.config/mutt/mailcap"

# ProtonMail folders (standard IMAP folders)
set record = "+Sent"
set postponed = "+Drafts"
set trash = "+Trash"
mailboxes "+INBOX" "+Archive" "+Sent" "+Drafts" "+Trash"


# Archive macro for ProtonMail
macro index,pager A "<save-message>+Archive<enter>" "Archive message"

# Vim-like keybindings
# First disable conflicting bindings
bind index g noop
bind pager g noop

#quick movements
macro index,pager gi "<change-folder>+INBOX<enter>" "Go to Inbox"
macro index,pager gd "<change-folder>+Drafts<enter>" "Go to Drafts"  
macro index,pager ga "<change-folder>+Archive<enter>" "Go to Archive"
macro index,pager gs "<change-folder>+Sent<enter>" "Go to Sent"
macro index,pager gt "<change-folder>+Trash<enter>" "Go to Trash"
macro index,pager g? "<change-folder>?" "show folder browser"

# Navigation
bind index gg first-entry
bind index G last-entry
bind index \Cd half-down
bind index \Cu half-up
bind pager gg top
bind pager G bottom
bind pager \Cd half-down
bind pager \Cu half-up

# Actions
bind index D delete-message
bind index U undelete-message
bind index F search
bind index R group-reply
bind pager D delete-message
bind pager U undelete-message
bind pager F search
bind pager R group-reply

# Additional Vim-like bindings
bind index j next-entry
bind index k previous-entry
bind index J next-thread
bind index K previous-thread
bind index l display-message
bind index h change-folder
bind pager j next-line
bind pager k previous-line
bind pager l view-attachments
bind pager h exit

# Attachments
bind attach l view-attach
bind attach h exit

# More Vim-inspired commands
bind index / search
bind index n search-next
bind index N search-opposite
bind index * search-next
bind index \# search-opposite
bind pager / search
bind pager n search-next
bind pager N search-opposite

# Visual mode-like selection
bind index v tag-entry
bind index V tag-pattern
bind index \Cv tag-prefix

# Quick movements
bind index H top-page
bind index M middle-page
bind index L bottom-page
bind pager H top
bind pager L bottom

# File operations (Vim-like)
bind index o sort-mailbox
bind index O sort-reverse
bind compose o edit-message

# aliases
macro index,pager a "<alias-dialog>" "Show aliases"
