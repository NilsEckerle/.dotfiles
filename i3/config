# i3 config file (v4)
# Configured to match Hyprland setup with Gruvbox theme
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

set $mod Mod4

# Font for window titles and bar (matching Hyprland style)
font pango:JetBrainsMono Nerd Font 10

# Gruvbox Dark color scheme
set $bg0_hard    #1d2021
set $bg0         #282828
set $bg0_soft    #32302f
set $bg1         #3c3836
set $bg2         #504945
set $bg3         #665c54
set $bg4         #7c6f64
set $gray        #928374
set $fg0         #fbf1c7
set $fg1         #ebdbb2
set $fg2         #d5c4a1
set $fg3         #bdae93
set $fg4         #a89984
set $red         #fb4934
set $green       #b8bb26
set $yellow      #fabd2f
set $blue        #83a598
set $purple      #d3869b
set $aqua        #8ec07c
set $orange      #fe8019

# Set GTK theme (matching Hyprland)
exec_always --no-startup-id xrdb -merge ~/.Xresources
exec --no-startup-id export GTK_THEME=Gruvbox-Orange-Dark

#################
### AUTOSTART ###
#################

# Start i3bar with i3status
exec_always --no-startup-id $HOME/.config/polybar/launch.sh || i3bar

# Composite manager (picom/compton) - matching Hyprland's compositor feel
exec --no-startup-id picom --config ~/.config/picom/picom.conf

# Wallpaper (nitrogen as alternative to hyprpaper)
exec --no-startup-id nitrogen --restore

# Notification daemon (dunst matches Hyprland setup)
exec --no-startup-id dunst

# System tray applets
exec --no-startup-id nm-applet

# Start terminal on workspace 1 (matching Hyprland)
exec --no-startup-id i3-msg 'workspace 1; exec alacritty'

# Start Firefox on workspace 6 (matching Hyprland)
exec --no-startup-id i3-msg 'workspace 6; exec firefox'

# Conky (if desired)
# exec --no-startup-id ~/.config/scripts/start-conky.sh

#####################
### LOOK AND FEEL ###
#####################

# Gaps (matching Hyprland: gaps_in=2, gaps_out=2)
gaps inner 2
gaps outer 2

# Border size (matching Hyprland: border_size=1)
default_border pixel 1
default_floating_border pixel 1

# Hide edge borders
hide_edge_borders none

# Window colors          border    background  text    indicator  child_border
client.focused           $gray     $bg1        $fg1    $gray      $gray
client.focused_inactive  $bg1      $bg0        $fg4    $bg1       $bg1
client.unfocused         $bg1      $bg0        $fg4    $bg1       $bg1
client.urgent            $red      $red        $fg0    $red       $red
client.placeholder       $bg0      $bg0        $fg4    $bg0       $bg0
client.background        $bg0

# Window rules
for_window [class=".*"] border pixel 1

# Floating windows (similar to Hyprland's togglefloating)
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="Nitrogen"] floating enable

#####################
### KEYBINDINGS ###
#####################

# Terminal (matching Hyprland: $mainMod + Return)
bindsym $mod+Return exec --no-startup-id kitty

# Kill focused window (matching Hyprland: $mainMod + C)
bindsym $mod+c kill

# Exit i3 (matching Hyprland: $mainMod + Q)
bindsym $mod+q exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"

# Toggle floating (matching Hyprland: $mainMod + V)
bindsym $mod+v floating toggle

# Application launcher (matching Hyprland: $mainMod + R -> rofi/wofi)
bindsym $mod+r exec --no-startup-id rofi -show drun -theme ~/.config/rofi/config.rasi

# Lock screen (matching Hyprland: $mainMod + Shift + L with gruvbox colors)
bindsym $mod+Shift+l exec --no-startup-id i3lock -c 282828 --inside-color=1d2021 --ring-color=3c3836 --keyhl-color=fe8019 --bshl-color=cc241d --text-color=ebdbb2

# Fullscreen (matching Hyprland: $mainMod + F)
bindsym $mod+f fullscreen toggle

# Music player (matching Hyprland: $mainMod + M -> rmpc in tmux)
bindsym $mod+m exec --no-startup-id kitty sh -c 'tmux new-session rmpc'

# File manager
bindsym $mod+e exec --no-startup-id nemo

# Screenshots (matching Hyprland: $mainMod + Shift + S)
bindsym $mod+Shift+s exec --no-startup-id scrot -s -e 'mv $f ~/Pictures/Screenshots/'

# Calculator (rofi-calc if installed)
bindsym $mod+equal exec --no-startup-id ~/.config/rofi/scripts/rofi-calculator-script.sh

###################
### FOCUS/MOVE ###
###################

# Change focus (matching Hyprland: H J K L vim keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Alternatively, arrow keys
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Alternatively, arrow keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split orientation
bindsym $mod+b split h
bindsym $mod+n split v

# Change container layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split

# Focus parent/child
bindsym $mod+a focus parent
bindsym $mod+z focus child

# Toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

####################
### WORKSPACES ###
####################

# Define workspace names
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace (matching Hyprland: $mainMod + [0-9])
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace (matching Hyprland: $mainMod + Shift + [0-9])
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Workspace assignment to monitors (matching Hyprland's dual monitor setup)
# Note: Replace output names with your actual monitor names (use xrandr to check)
# Workspaces 1-5 on primary monitor (DP-1 equivalent)
workspace $ws1 output primary
workspace $ws2 output primary
workspace $ws3 output primary
workspace $ws4 output primary
workspace $ws5 output primary

# Workspaces 6-10 on secondary monitor (HDMI-A-1 equivalent)
# workspace $ws6 output HDMI-1
# workspace $ws7 output HDMI-1
# workspace $ws8 output HDMI-1
# workspace $ws9 output HDMI-1
# workspace $ws10 output HDMI-1

# Uncomment and adjust the output names above based on your xrandr output

################
### SCRATCHPAD ###
################

# Move to scratchpad
bindsym $mod+Shift+minus move scratchpad

# Show scratchpad
bindsym $mod+minus scratchpad show

##############
### RESIZE ###
##############

# Resize window mode
mode "resize" {
  bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt

    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+x mode "resize"

##################
### STATUS BAR ###
##################

# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
bar {
  status_command i3blocks -c ~/.config/i3blocks/i3blocks.conf
    position bottom
    height 18
    separator_symbol " | "

    colors {
      background $bg0
        statusline $fg1
        separator  $gray

# Workspace colors    border    background  text
        focused_workspace     $gray     $bg1        $fg1
        active_workspace      $bg1      $bg0        $fg4
        inactive_workspace    $bg1      $bg0        $fg4
        urgent_workspace      $red      $red        $fg0
        binding_mode          $orange   $orange     $bg0
    }
}

# Alternative: Use polybar instead of i3bar
# exec_always --no-startup-id $HOME/.config/polybar/launch.sh

####################
### RELOAD/RESTART ###
####################

# Reload the configuration file
bindsym $mod+Shift+c reload

# Restart i3 inplace (preserves your layout/session)
bindsym $mod+Shift+r restart

###################
### MEDIA KEYS ###
###################

# Volume control (using pactl)
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Brightness control (using brightnessctl or xbacklight)
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# Media player controls
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

###############
### MOUSE ###
###############

# Use Mouse+$mod to drag floating windows (matching Hyprland's drag behavior)
floating_modifier $mod

# Focus follows mouse
focus_follows_mouse yes

# Mouse warping
mouse_warping none
