# i3 config file (v4)
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

#################################
#           Variables           #
#################################

# Set modifiers
set $super Mod1
set $alt Mod4

# Set font
font pango:FiraCode Nerd Font 11

# Set gruvbox colorscheme colors
set $bg       #282828
set $red      #cc241d
set $green    #98971a
set $yellow   #d79921
set $blue     #458588
set $purple   #b16286
set $aqua     #689d68
set $gray     #a89984
set $darkgray #1d2021
set $white    #ebdbb2

# Workspace names
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

#################################
#        General Settings       #
#################################

# Don't focus updated window
# focus_on_window_activation none

# Use mouse+$super to drag floating windows
floating_modifier $super

# Hide edge borders
hide_edge_borders smart

# Gaps
gaps inner 12
gaps outer 0
smart_gaps on

# Window borders
for_window [class=".*"] border pixel 3

# Disable mouse warping
mouse_warping none

#################################
#          Autostart            #
#################################

# Compositor for transparency and effects
exec --no-startup-id picom

# start comption
exec_always --no-startup-id compton -b

# Wallpaper
exec --no-startup-id nitrogen --restore

# Network manager applet
exec --no-startup-id nm-applet

# Bluetooth manager
exec --no-startup-id blueman-applet

# Audio control
exec --no-startup-id pasystray

# Notification daemon
exec --no-startup-id dunst

# Auto-lock screen after 10 minutes
exec --no-startup-id xss-lock -- i3lock -c 282828

# Restore layout (if you use it)
# exec --no-startup-id i3-msg 'workspace $ws1; append_layout ~/.config/i3/workspace-1.json'

# Setup background
exec --no-startup-id feh --bg-fill ~/wallpaper/gruv-astronaut.png

# Start applications
exec --no-startup-id kitty
exec --no-startup-id firefox
exec XDG_DATA_DIRS=/usr/share/:/usr/local/share/:/var/lib/snapd/desktop:/var/lib/flatpak/exports/share rofi --no-startup-id spotify
exec XDG_DATA_DIRS=/usr/share/:/usr/local/share/:/var/lib/snapd/desktop:/var/lib/flatpak/exports/share rofi --no-startup-id discord

#################################
#         Key Bindings          #
#################################

# Terminal
bindsym $super+Return exec kitty
bindsym $super+Shift+Return exec kitty --class floating-terminal
for_window [class="floating-terminal"] floating enable, resize set 800 600, move position center

# Application launcher
bindsym $super+d exec XDG_DATA_DIRS=/usr/share/:/usr/local/share/:/var/lib/snapd/desktop:/var/lib/flatpak/exports/share rofi -show drun
bindsym $super+Shift+d exec XDG_DATA_DIRS=/usr/share/:/usr/local/share/:/var/lib/snapd/desktop:/var/lib/flatpak/exports/share rofi -show run
bindsym $super+Tab exec XDG_DATA_DIRS=/usr/share/:/usr/local/share/:/var/lib/snapd/desktop:/var/lib/flatpak/exports/share rofi -show window

# File manager
bindsym $super+e exec thunar

# Web browser
bindsym $super+w exec firefox

# Lock screen
bindsym $super+l exec i3lock -c 282828

# Screenshots
bindsym Print exec scrot 'Screenshot_%Y-%m-%d_%H-%M-%S.png' -e 'mv $f ~/Pictures/ && notify-send "Screenshot saved" "$f"'
bindsym Shift+Print exec scrot -s 'Screenshot_%Y-%m-%d_%H-%M-%S.png' -e 'mv $f ~/Pictures/ && notify-send "Screenshot saved" "$f"'
bindsym $super+Print exec scrot -u 'Screenshot_%Y-%m-%d_%H-%M-%S.png' -e 'mv $f ~/Pictures/ && notify-send "Screenshot saved" "$f"'

# Kill focused window
bindsym $super+c kill
bindsym $alt+F4 kill

#################################
#       Window Navigation       #
#################################

# Change focus
bindsym $super+h focus left
bindsym $super+j focus down
bindsym $super+k focus up
bindsym $super+semicolon focus right

# Arrow keys
bindsym $super+Left focus left
bindsym $super+Down focus down
bindsym $super+Up focus up
bindsym $super+Right focus right

# Move focused window
bindsym $super+Shift+h move left
bindsym $super+Shift+j move down
bindsym $super+Shift+k move up
bindsym $super+Shift+semicolon move right

# Arrow keys
bindsym $super+Shift+Left move left
bindsym $super+Shift+Down move down
bindsym $super+Shift+Up move up
bindsym $super+Shift+Right move right

#################################
#         Layout Control        #
#################################

# Split orientation
bindsym $super+b split h
bindsym $super+v split v

# Change container layout
bindsym $super+s layout stacking
bindsym $super+t layout tabbed
bindsym $super+y layout toggle split

# Toggle fullscreen
bindsym $super+f fullscreen toggle

# Toggle tiling / floating
bindsym $super+Shift+space floating toggle

# Change focus between tiling / floating windows
bindsym $super+space focus mode_toggle

# Focus parent/child container
# bindsym $super+a focus parent
# bindsym $super+c focus child

#################################
#         Workspaces            #
#################################

# Switch to workspace
bindsym $super+1 workspace $ws1
bindsym $super+2 workspace $ws2
bindsym $super+3 workspace $ws3
bindsym $super+4 workspace $ws4
bindsym $super+5 workspace $ws5
bindsym $super+6 workspace $ws6
bindsym $super+7 workspace $ws7
bindsym $super+8 workspace $ws8
bindsym $super+9 workspace $ws9
bindsym $super+0 workspace $ws10

# Move container to workspace
bindsym $super+Shift+1 move container to workspace $ws1
bindsym $super+Shift+2 move container to workspace $ws2
bindsym $super+Shift+3 move container to workspace $ws3
bindsym $super+Shift+4 move container to workspace $ws4
bindsym $super+Shift+5 move container to workspace $ws5
bindsym $super+Shift+6 move container to workspace $ws6
bindsym $super+Shift+7 move container to workspace $ws7
bindsym $super+Shift+8 move container to workspace $ws8
bindsym $super+Shift+9 move container to workspace $ws9
bindsym $super+Shift+0 move container to workspace $ws10

# Move to workspace with focused container
bindsym $super+$alt+1 move container to workspace $ws1; workspace $ws1
bindsym $super+$alt+2 move container to workspace $ws2; workspace $ws2
bindsym $super+$alt+3 move container to workspace $ws3; workspace $ws3
bindsym $super+$alt+4 move container to workspace $ws4; workspace $ws4
bindsym $super+$alt+5 move container to workspace $ws5; workspace $ws5
bindsym $super+$alt+6 move container to workspace $ws6; workspace $ws6
bindsym $super+$alt+7 move container to workspace $ws7; workspace $ws7
bindsym $super+$alt+8 move container to workspace $ws8; workspace $ws8
bindsym $super+$alt+9 move container to workspace $ws9; workspace $ws9
bindsym $super+$alt+0 move container to workspace $ws10; workspace $ws10

# Navigate workspaces
bindsym $super+Ctrl+Right workspace next
bindsym $super+Ctrl+Left workspace prev

# Back and forth workspace switching
workspace_auto_back_and_forth yes
bindsym $super+z workspace back_and_forth
bindsym $super+Shift+z move container to workspace back_and_forth; workspace back_and_forth

#################################
#        Media Controls         #
#################################

# Volume control
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && notify-send "Volume" "$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+(?=%)' | head -1)%"
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && notify-send "Volume" "$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+(?=%)' | head -1)%"
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && notify-send "Volume" "Muted"

# Brightness control
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set 5%+ && notify-send "Brightness" "$(brightnessctl get)"
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%- && notify-send "Brightness" "$(brightnessctl get)"

# Media player controls
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

#################################
#           Modes               #
#################################

# Resize mode
mode "resize" {
    bindsym h resize shrink width 5 px or 5 ppt
    bindsym j resize grow height 5 px or 5 ppt
    bindsym k resize shrink height 5 px or 5 ppt
    bindsym semicolon resize grow width 5 px or 5 ppt

    bindsym Left resize shrink width 5 px or 5 ppt
    bindsym Down resize grow height 5 px or 5 ppt
    bindsym Up resize shrink height 5 px or 5 ppt
    bindsym Right resize grow width 5 px or 5 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $super+r mode "default"
}
bindsym $super+r mode "resize"

# Power management mode
set $mode_system (l)ock, (e)xit, switch_(u)ser, (s)uspend, (h)ibernate, (r)eboot, (Shift+s)hutdown
mode "$mode_system" {
    bindsym l exec --no-startup-id i3exit lock, mode "default"
    bindsym s exec --no-startup-id i3exit suspend, mode "default"
    bindsym u exec --no-startup-id i3exit switch_user, mode "default"
    bindsym e exec --no-startup-id i3exit logout, mode "default"
    bindsym h exec --no-startup-id i3exit hibernate, mode "default"
    bindsym r exec --no-startup-id i3exit reboot, mode "default"
    bindsym Shift+s exec --no-startup-id i3exit shutdown, mode "default"

    # Exit system mode: "Enter" or "Escape"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $super+Shift+e mode "$mode_system"

#################################
#        Window Rules           #
#################################

# Assign applications to workspaces
assign [class="kitty"] workspace $ws1
assign [class="firefox"] workspace $ws2
assign [class="code"] workspace $ws3
assign [class="spotify"] workspace $ws9
assign [class="discord"] workspace $ws10

# spotify fix (doesn't always respect assign)
for_window [class="spotify"] move to workspace $ws9

# Floating windows
for_window [class="Arandr"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="Blueman-manager"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [title="File Transfer*"] floating enable
for_window [class="Galculator"] floating enable
for_window [class="GParted"] floating enable
for_window [title="i3_help"] floating enable sticky enable border normal
for_window [class="Lightdm-settings"] floating enable
for_window [class="Lxappearance"] floating enable sticky enable border normal
for_window [class="Manjaro-hello"] floating enable
for_window [class="Manjaro Settings Manager"] floating enable border normal
for_window [title="MuseScore: Play Panel"] floating enable
for_window [class="Nitrogen"] floating enable sticky enable border normal
for_window [class="Oblogout"] fullscreen enable
for_window [class="octopi"] floating enable
for_window [title="About Pale Moon"] floating enable
for_window [class="Pamac-manager"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="qt5ct"] floating enable sticky enable border normal
for_window [class="Qtconfig-qt4"] floating enable sticky enable border normal
for_window [class="Simple-scan"] floating enable border normal
for_window [class="(?i)System-config-printer.py"] floating enable border normal
for_window [class="Skype"] floating enable border normal
for_window [class="Timeset-gui"] floating enable border normal
# for_window [class="(?i)virtualbox"] floating enable border normal
for_window [class="Xfburn"] floating enable

# Media windows
for_window [class="Eog|Sxiv|feh|mpv|Vlc|File-roller|Xarchiver"] floating enable
for_window [class="Eog|Sxiv|feh|mpv|Vlc|File-roller|Xarchiver"] focus

# Scratchpad
for_window [instance="scratchpad"] move scratchpad
exec --no-startup-id kitty --name scratchpad
bindsym $super+u [instance="scratchpad"] scratchpad show

#################################
#         Status Bar            #
#################################

bar {
	position bottom
		status_command i3status -c ~/.config/i3/i3status.conf
		font pango:FiraCode Nerd Font 11
		height 24
		separator_symbol " │ "
		# strip_workspace_numbers yes

		colors {
			background $bg
				statusline $white
				separator $gray

				#                   border    backgr.   text
				focused_workspace   $aqua     $aqua     $darkgray
				inactive_workspace  $bg       $bg       $gray
				active_workspace    $gray     $gray     $yellow
				urgent_workspace    $red      $red      $bg
				binding_mode        $yellow   $yellow   $darkgray
		}

	tray_output primary
		tray_padding 1
}

#################################
#        Window Colors          #
#################################

# class                 border    backgr.   text      indicator child_border
client.focused          $blue     $blue     $darkgray $purple   $blue
client.focused_inactive $darkgray $darkgray $yellow   $purple   $darkgray
client.unfocused        $darkgray $darkgray $yellow   $purple   $darkgray
client.urgent           $red      $red      $white    $red      $red
client.placeholder      $bg       $bg       $white    $bg       $bg
client.background       $bg

#################################
#       System Controls         #
#################################

# Reload configuration file
bindsym $super+Shift+c reload

# Restart i3 inplace
bindsym $super+Shift+r restart

# Exit i3 (logs you out of your X session)
bindsym $super+Shift+q exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"
