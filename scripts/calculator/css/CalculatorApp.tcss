Screen {
    background: #282828;
    align: center middle;
}

Footer {
    background: #282828;
}

Header {
    background: #282828;
}

#calculator {
    width: 80;
    height: auto;
    background: #282828;
    padding: 1 2;
    border: solid #fe8019;
}

#display-container {
    height: 9;
    background: #3c3836;
    border: solid #fe8019;
    margin-bottom: 1;
    padding: 1;
}

#input {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    background: #1d2021;
    color: #ebdbb2;
}

#input:focus {
    border: tall #fe8019;
}

#result {
    width: 100%;
    height: 1;
    content-align: right middle;
    color: #b8bb26;
    text-style: bold;
    padding: 0 1;
}

#buttons {
    height: auto;
}

.button-row {
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

Button {
    width: 1fr;
    min-width: 10;
    height: 3;
    margin: 0 1;
    color: #ebdbb2;
    border: none;
}

.function-btn {
    background: #458588;
}

.function-btn:hover {
    background: #83a598;
}

.operator-btn {
    background: #d79921;
}

.operator-btn:hover {
    background: #fabd2f;
}

.number-btn {
    background: #504945;
}

.number-btn:hover {
    background: #665c54;
}

.special-btn {
    background: #cc241d;
}

.special-btn:hover {
    background: #fb4934;
}

#equals2 {
    visibility: hidden;
}

/* Compact mode for smaller screens */
.compact #calculator {
    width: 42;
    padding: 1 2;
}

.compact #display-container {
    height: 5;
    padding: 0 1;
}

.compact #input {
    height: 1;
    border: none;
}

.compact .button-row {
    height: 2;
    margin-bottom: 0;
}

.compact .uninportant {
  display: none;
}

.compact Button {
    min-width: 6;
    width: 6;
    height: 2;
    padding: 0;
    margin: 1 1;
}
